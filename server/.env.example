PORT=5000
MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>/librarysystem?retryWrites=true&w=majority
JWT_SECRET=<replace-with-a-long-random-secret-before-authentication>
CLIENT_URL=http://localhost:5173
# Opt in to HTTP localhost/127.0.0.1 Flutter Web origins on any valid port, even in production.
ALLOW_LOCAL_FLUTTER_WEB=false
# Hosting: NODE_ENV=production, CLIENT_URL=https://your-frontend.example
# Set TRUST_PROXY=1 only behind a verified single trusted proxy; local default is 0.
TRUST_PROXY=0
